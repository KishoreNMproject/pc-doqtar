
package org.pcdoqtar.service;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.SerializationFeature;
import org.pcdoqtar.diagnostics.SystemDiagnostics;
import org.pcdoqtar.model.DiagnosticResult;
import org.pcdoqtar.model.SystemHealthSnapshot;

import java.io.IOException;
import java.nio.file.AtomicMoveNotSupportedException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.StandardCopyOption;
import java.time.LocalDateTime;
import java.util.LinkedHashMap;
import java.util.Map;
import java.util.concurrent.atomic.AtomicBoolean;

@SuppressWarnings("unused")
public final class DiagnosticServiceMain {

    private static final long INTERVAL_MILLIS =
            5L * 60L * 1000L;

    private static final AtomicBoolean RUNNING =
            new AtomicBoolean(true);

    private static final ObjectMapper JSON =
            new ObjectMapper()
                    .enable(SerializationFeature.INDENT_OUTPUT);

    private DiagnosticServiceMain() {
    }

    public static void main(String[] args) {
        Thread.currentThread().setName("PC-DOQTAR-Diagnostic-Service");

        Path dataDirectory = resolveDataDirectory();
        Path outputFile = dataDirectory.resolve(
                "latest-diagnostics.json");

        Runtime.getRuntime().addShutdownHook(new Thread(
                () -> RUNNING.set(false),
                "PC-DOQTAR-Service-Shutdown"));

        try {
            Files.createDirectories(dataDirectory);
        } catch (IOException exception) {
            System.err.println(
                    "Cannot create diagnostic data directory: "
                            + exception.getMessage());
            System.exit(1);
            return;
        }

        System.out.println(
                "PC DOQTAR Diagnostic Service starting.");
        System.out.println("Output: " + outputFile.toAbsolutePath());

        SystemDiagnostics diagnostics = new SystemDiagnostics();

        while (RUNNING.get()) {
            try {
                SystemHealthSnapshot snapshot =
                        diagnostics.collectSnapshot();

                Map<String, Object> document =
                        createDocument(snapshot);

                writeAtomically(outputFile, document);

                System.out.println(
                        "Diagnostic snapshot saved at "
                                + snapshot.getTimestamp());

            } catch (Exception exception) {
                System.err.println(
                        "Diagnostic cycle failed: "
                                + exception.getMessage());
                exception.printStackTrace(System.err);
            }

            try {
                Thread.sleep(INTERVAL_MILLIS);
            } catch (InterruptedException exception) {
                Thread.currentThread().interrupt();
                RUNNING.set(false);
            }
        }

        System.out.println(
                "PC DOQTAR Diagnostic Service stopped.");
    }

    private static Path resolveDataDirectory() {
        String programData = System.getenv("PROGRAMDATA");

        if (programData == null || programData.isBlank()) {
            throw new IllegalStateException(
                    "PROGRAMDATA environment variable is unavailable.");
        }

        return Path.of(programData, "PCDOQTAR");
    }

    private static Map<String, Object> createDocument(
            SystemHealthSnapshot snapshot) {

        Map<String, Object> document = new LinkedHashMap<>();

        document.put("application", "PC DOQTAR");
        document.put("schemaVersion", 1);
        document.put("timestamp",
                snapshot.getTimestamp().toString());
        document.put("overallStatus",
                snapshot.getOverallStatus().name());
        document.put("warningCount",
                snapshot.getWarningCount());
        document.put("containsUnavailableResults",
                snapshot.hasUnavailableResults());

        document.put("cpu", resultToMap(snapshot.getCpu()));
        document.put("memory", resultToMap(snapshot.getMemory()));

        document.put("storage", snapshot.getStorage()
                .stream()
                .map(DiagnosticServiceMain::resultToMap)
                .toList());

        return document;
    }

    private static Map<String, Object> resultToMap(
            DiagnosticResult result) {

        Map<String, Object> item = new LinkedHashMap<>();

        item.put("metric", result.getMetric());
        item.put("value", result.getValue());
        item.put("unit", result.getUnit());
        item.put("status", result.getStatus().name());
        item.put("message", result.getMessage());

        return item;
    }

    private static void writeAtomically(
            Path destination,
            Map<String, Object> document) throws IOException {

        Path temporary = destination.resolveSibling(
                destination.getFileName() + ".tmp");

        JSON.writeValue(temporary.toFile(), document);

        try {
            Files.move(
                    temporary,
                    destination,
                    StandardCopyOption.REPLACE_EXISTING,
                    StandardCopyOption.ATOMIC_MOVE);
        } catch (AtomicMoveNotSupportedException exception) {
            Files.move(
                    temporary,
                    destination,
                    StandardCopyOption.REPLACE_EXISTING);
        }
    }
}
